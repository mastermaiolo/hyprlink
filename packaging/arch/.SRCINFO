pkgbase = hyprlink-bridge
	pkgdesc = Android phone ↔ Hyprland link over QUIC + mTLS: notifications, clipboard, files, media, webcam, mic
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/mastermaiolo/hyprlink
	arch = x86_64
	license = GPL-3.0-or-later
	license = OFL-1.1
	makedepends = cargo
	makedepends = clang
	makedepends = lld
	makedepends = pkgconf
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gstreamer
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gst-plugins-bad-libs
	depends = gst-libav
	depends = gst-plugin-pipewire
	depends = hyprland
	depends = libpulse
	depends = libxkbcommon
	depends = pipewire
	depends = wayland
	depends = wireplumber
	depends = wl-clipboard
	optdepends = v4l2loopback-dkms: telemóvel como webcam do PC (/dev/video42)
	optdepends = xdg-desktop-portal-gtk: seletor de ficheiros da GUI
	optdepends = grimblast-git: capturas de ecrã a partir do telemóvel
	optdepends = grim: capturas de ecrã (alternativa ao grimblast)
	optdepends = slurp: captura de uma área (com grim)
	optdepends = hyprlock: bloquear o PC a partir do telemóvel
	optdepends = noctalia: bloqueio pelo ecrã de bloqueio do Noctalia
	optdepends = nvidia-utils: temperatura e uso da GPU NVIDIA na telemetria
	optdepends = vulkan-icd-loader: GUI desenhada pela GPU (sem isto usa o renderizador por software)
	options = !lto
	options = !debug
	source = hyprlink-0.1.0.tar.gz::https://github.com/mastermaiolo/hyprlink/archive/v0.1.0.tar.gz
	source = hyprlink-bridge.service
	source = hyprlink-bridge.desktop
	source = hyprlink-bridge-autostart.desktop
	source = hyprlink-bridge.svg
	sha256sums = SKIP
	sha256sums = cebbc61cb25a2306422a16b8fba244c4b7077d9b06cf092704cb9e5603519562
	sha256sums = 6f135c38214913bfea0d692b9ee7532ec02088e1c1236d3c03a31888d82c216f
	sha256sums = c87c5e811a60b751a4914aed571908b863e9678ac282fb1ae009a601b2c394cb
